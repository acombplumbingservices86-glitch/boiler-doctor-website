---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StickyMobileBar from "../components/StickyMobileBar.astro";
import LocalBusinessSchema from "../components/LocalBusinessSchema.astro";
import { siteConfig } from "../data/siteConfig";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---
<!doctype html>
<html lang="en-GB">
  <head>
    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-5BSW3SWP');</script>
    <!-- End Google Tag Manager -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0b1f3a" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/og-image.png", Astro.site).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <LocalBusinessSchema />

    <!-- Google tag (gtag.js) -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${siteConfig.gaMeasurementId}`}></script>
    <script define:vars={{ gaId: siteConfig.gaMeasurementId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      // Astro compiles this define:vars block into an IIFE, so a bare
      // `function gtag(){}` stays local to that IIFE and never becomes
      // window.gtag — silently breaking any later code (e.g. trackLead()
      // below) that calls window.gtag(...) directly. Expose it explicitly.
      window.gtag = gtag;
      gtag("js", new Date());
      gtag("config", gaId);
    </script>

    <!--
      Meta Pixel now lives inside the GTM container (GTM-5BSW3SWP), not here —
      Steve is configuring it directly in Tag Manager, so there's no
      hardcoded fbq() install on the page. Keeping both would double-fire
      PageView/Lead events into the same pixel.
    -->

    <!--
      Shared lead-tracking helper. Fires a GA4 "generate_lead" event directly,
      and pushes a "generate_lead" event into the GTM dataLayer (with a
      lead_method field) for every way someone contacts us: the contact form
      (called from ContactForm.astro on a successful submit), and any
      tel:/mailto: link anywhere on the site — header, footer, /contact/,
      /book-online/, all covered automatically since this listens on the
      whole document rather than per-component. Set up a Custom Event
      trigger on "generate_lead" in GTM to fire the Meta "Lead" tag (and
      anything else) off this.
    -->
    <script>
      window.dataLayer = window.dataLayer || [];
      window.trackLead = function (method) {
        try {
          if (window.gtag) {
            window.gtag("event", "generate_lead", { method });
          }
          window.dataLayer.push({ event: "generate_lead", lead_method: method });
        } catch (err) {
          console.warn("trackLead failed:", err);
        }
      };

      document.addEventListener("click", function (e) {
        const link = e.target.closest('a[href^="tel:"], a[href^="mailto:"]');
        if (!link) return;
        window.trackLead(link.getAttribute("href").startsWith("tel:") ? "phone" : "email");
      });
    </script>
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5BSW3SWP"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <a href="#main" class="visually-hidden">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <StickyMobileBar />
  </body>
</html>
