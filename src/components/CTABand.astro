---
import { siteConfig } from "../data/siteConfig";
interface Props {
  heading: string;
  subheading?: string;
  guideHref?: string;
  guideLabel?: string;
}
const { heading, subheading, guideHref, guideLabel } = Astro.props;
---
<section class="section section--navy cta-band">
  <div class="container cta-band__inner">
    <div>
      <h2>{heading}</h2>
      {subheading && <p>{subheading}</p>}
    </div>
    <div class="cta-band__actions">
      <a href="/book-online/" class="btn btn--primary">Book Online</a>
      <a href={siteConfig.phoneHref} class="btn btn--on-navy">Call {siteConfig.phoneDisplay}</a>
      {siteConfig.whatsappReady && (
        <a href={`https://wa.me/${siteConfig.whatsappNumberIntl}`} class="btn btn--on-navy">WhatsApp Us</a>
      )}
      {guideHref && <a href={guideHref} class="btn btn--on-navy btn--guide">{guideLabel ?? "Get the free guide"}</a>}
    </div>
  </div>
</section>

<style>
  .cta-band__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .cta-band__actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .btn--guide { background: transparent; border: 2px solid rgba(255,255,255,0.4); }
  .btn--guide:hover { border-color: rgba(255,255,255,0.8); }
</style>
