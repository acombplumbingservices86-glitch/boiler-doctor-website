---
import { siteConfig } from "../data/siteConfig";
interface Props {
  heading: string;
  subheading?: string;
}
const { heading, subheading } = Astro.props;
---
<section class="section section--navy cta-band">
  <div class="container cta-band__inner">
    <div>
      <h2>{heading}</h2>
      {subheading && <p>{subheading}</p>}
    </div>
    <div class="cta-band__actions">
      <a href="/book-online/" class="btn btn--primary">Book Online</a>
      <a href={siteConfig.phoneHref} class="btn btn--on-navy">Call {siteConfig.phoneDisplay}</a>
    </div>
  </div>
</section>

<style>
  .cta-band__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .cta-band__actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
</style>
