---
// Instant boiler price tool.
//
// Deliberately different from LeadMagnetForm: the recommended boiler + guide
// price are shown immediately after the diagnostic questions, with ZERO
// contact info required (Steve's explicit brief). A "Get a detailed quote"
// step is optional and only appears if the visitor asks for one — it then
// POSTs to siteConfig.leadWebhookUrl exactly the way LeadMagnetForm does.
//
// PRICING NOTE FOR STEVE: the two base figures below (£2,500 like-for-like,
// £3,500 conversion) are copied from your own published numbers on
// /advice-centre/new-boiler-cost/ and /new-boiler-installation/ — not invented.
// The size-based uplifts and the £450 Essential→Premium gap ARE my own
// reasonable assumption to turn your single guide figure into two tiers,
// kept inside your own stated £2,500–£6,000 typical range. Please sanity
// check SIZE_UPLIFT and PREMIUM_UPLIFT below (in the client script) and
// I'll adjust them — easy either way.
import { siteConfig } from "../data/siteConfig";

interface Option {
  value: string;
  icon: string;
}
interface Step {
  key: string;
  question: string;
  options: Option[];
}

const steps: Step[] = [
  {
    key: "systemType",
    question: "What type of system do you have now?",
    options: [
      { value: "Combi boiler", icon: "combi" },
      { value: "System boiler (with a cylinder)", icon: "cylinder" },
      { value: "Regular / heat-only boiler", icon: "radiator" },
      { value: "Not sure", icon: "question" },
    ],
  },
  {
    key: "situation",
    question: "What are you looking to do?",
    options: [
      { value: "Replace a broken boiler, like-for-like", icon: "refresh" },
      { value: "Upgrade to a different system type", icon: "upgrade" },
      { value: "Not sure yet — just exploring", icon: "search" },
    ],
  },
  {
    key: "bedrooms",
    question: "How many bedrooms in the property?",
    options: [
      { value: "1–2", icon: "house" },
      { value: "3–4", icon: "house" },
      { value: "5+", icon: "house" },
    ],
  },
  {
    key: "bathrooms",
    question: "How many bathrooms or showers might run at the same time?",
    options: [
      { value: "1", icon: "droplet" },
      { value: "2", icon: "droplet" },
      { value: "3+", icon: "droplet" },
    ],
  },
  {
    key: "boilerAge",
    question: "How old is your current boiler?",
    options: [
      { value: "Under 10 years", icon: "clock" },
      { value: "10–15 years", icon: "clock" },
      { value: "15+ years", icon: "clock" },
      { value: "No boiler yet", icon: "newhome" },
    ],
  },
];

const totalSteps = steps.length;
---
<div class="bpt" id="bpt-calculator">
  <div class="bpt__progress-track" role="progressbar" aria-valuemin="0" aria-valuemax={totalSteps} aria-valuenow="1" aria-label="Progress">
    <div class="bpt__progress-fill"></div>
  </div>
  <p class="bpt__stepcount"><span class="bpt__stepcount-current">1</span> of {totalSteps}</p>

  <div class="bpt__stage">
    <div class="bpt__panel bpt__panel--intro is-active" data-panel="intro">
      <h2 class="visually-hidden">Quick questions</h2>
      <p class="bpt__intro">Tap the answers that match your home. You'll get a recommended boiler and a guide price straight away — no name, email or phone number needed.</p>
      <button type="button" class="btn btn--primary bpt__start">Get my price</button>
    </div>

    {steps.map((step, i) => (
      <div class="bpt__panel" data-panel={`step-${i}`} data-key={step.key}>
        <h2 class="bpt__question">{step.question}</h2>
        <div class="bpt__choices" data-count={step.options.length}>
          {step.options.map((opt) => (
            <button type="button" class="bpt__choice" data-value={opt.value} data-icon={opt.icon}>
              <span class="bpt__choice-icon" data-icon={opt.icon} aria-hidden="true"></span>
              <span class="bpt__choice-label">{opt.value}</span>
            </button>
          ))}
        </div>
        {i > 0 && <button type="button" class="bpt__back">← Back</button>}
      </div>
    ))}

    <div class="bpt__panel" data-panel="result">
      <p class="bpt__result-eyebrow">Your recommendation</p>
      <h2 class="bpt__question bpt__result-heading">We'd recommend a <span class="bpt__result-system"></span></h2>
      <p class="bpt__result-sub"></p>

      <div class="bpt__packages">
        <div class="bpt__package" data-tier="essential">
          <span class="bpt__package-badge bpt__package-badge--muted">Essential</span>
          <span class="bpt__package-icon" aria-hidden="true"></span>
          <p class="bpt__package-brand">Worcester Bosch or Ideal</p>
          <p class="bpt__package-price"></p>
          <ul class="bpt__package-features">
            <li>Correctly sized for your home, not oversold</li>
            <li>Manufacturer's warranty confirmed at your free visit</li>
            <li>{siteConfig.warranty} workmanship warranty from us</li>
          </ul>
        </div>
        <div class="bpt__package bpt__package--featured" data-tier="premium">
          <span class="bpt__package-badge">Premium</span>
          <span class="bpt__package-icon" aria-hidden="true"></span>
          <p class="bpt__package-brand">Worcester Bosch or Ideal, higher-output range</p>
          <p class="bpt__package-price"></p>
          <ul class="bpt__package-features">
            <li>Quieter running, higher hot water output</li>
            <li>Smart control-ready</li>
            <li>{siteConfig.warranty} workmanship warranty from us</li>
          </ul>
        </div>
      </div>

      <p class="bpt__result-footnote">Both prices include fitting, removing your old boiler, and VAT. They're a guide, not a fixed quote — the exact number depends on what we find at a free home visit.</p>

      <div class="bpt__result-cta">
        <button type="button" class="btn btn--primary bpt__want-quote">Get a detailed, fixed quote</button>
        <a href={siteConfig.phoneHref} class="btn btn--secondary">Call {siteConfig.phoneDisplay}</a>
      </div>
      <button type="button" class="bpt__back bpt__restart">← Change my answers</button>
    </div>

    <div class="bpt__panel" data-panel="quote">
      <h2 class="bpt__question">Where should we send your fixed quote?</h2>
      <p class="bpt__quote-sub">We'll use what you've already told us, so this takes seconds. {siteConfig.yearsTrading} years trading, Gas Safe registered, {siteConfig.reviews.countLabel} reviews.</p>
      <form class="bpt__contact-form">
        <label>
          <span>Name</span>
          <input type="text" name="name" required autocomplete="name" />
        </label>
        <label>
          <span>Mobile number</span>
          <input type="tel" name="phone" required autocomplete="tel" />
        </label>
        <label>
          <span>Email</span>
          <input type="email" name="email" required autocomplete="email" />
        </label>
        <button type="submit" class="btn btn--primary bpt__submit">Get my fixed quote</button>
      </form>
      <button type="button" class="bpt__back">← Back to my price</button>
    </div>

    <div class="bpt__panel" data-panel="sent">
      <div class="bpt__result-icon">✓</div>
      <h2 class="bpt__question">Thanks, <span class="bpt__sent-name"></span></h2>
      <p class="bpt__sent-body">Someone from the team will call or text you on <span class="bpt__sent-phone"></span> to book your free home visit and lock in a proper written quote. No obligation.</p>
      <div class="bpt__result-cta">
        <a href="/book-online/" class="btn btn--primary">Book a Free Visit Now</a>
        <a href={siteConfig.phoneHref} class="btn btn--secondary">Call {siteConfig.phoneDisplay}</a>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ webhookUrl: siteConfig.leadWebhookUrl, sourcePage: "/boiler-price-calculator/", phoneDisplay: siteConfig.phoneDisplay }}>
  (function () {
    const ICONS = {
      combi: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2.5" width="12" height="19" rx="2"/><circle cx="12" cy="7.5" r="1.6"/><line x1="8.5" y1="12" x2="15.5" y2="12"/><line x1="8.5" y1="15" x2="15.5" y2="15"/><line x1="8.5" y1="18" x2="13" y2="18"/></svg>',
      cylinder: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8 4a4 4 0 0 1 8 0v16H8V4z"/><ellipse cx="12" cy="4" rx="4" ry="1.6"/><line x1="8" y1="11" x2="16" y2="11"/></svg>',
      radiator: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="12" rx="1.5"/><line x1="7" y1="6" x2="7" y2="18"/><line x1="11" y1="6" x2="11" y2="18"/><line x1="15" y1="6" x2="15" y2="18"/><line x1="19" y1="6" x2="19" y2="18"/></svg>',
      question: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 1 1 3.5 2.3c-.8.4-1 .9-1 1.7"/><line x1="12" y1="16.5" x2="12" y2="16.6"/></svg>',
      refresh: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12a8 8 0 0 1 13.66-5.66L20 8"/><path d="M20 4v4h-4"/><path d="M20 12a8 8 0 0 1-13.66 5.66L4 16"/><path d="M4 20v-4h4"/></svg>',
      upgrade: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V7"/><path d="M6.5 12.5 12 7l5.5 5.5"/><line x1="5" y1="20" x2="19" y2="20"/></svg>',
      search: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="10.5" cy="10.5" r="6.5"/><line x1="20" y1="20" x2="15.5" y2="15.5"/></svg>',
      house: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11.5 12 4l8 7.5"/><path d="M6 10v10h12V10"/><line x1="10" y1="20" x2="10" y2="14"/><line x1="14" y1="20" x2="14" y2="14"/></svg>',
      droplet: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3s6 7 6 11.5a6 6 0 0 1-12 0C6 10 12 3 12 3z"/></svg>',
      clock: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>',
      newhome: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11.5 12 4l8 7.5"/><path d="M6 10v10h4v-5h4v5h4V10"/><line x1="12" y1="1.5" x2="12" y2="5"/><line x1="10.3" y1="3" x2="13.7" y2="3"/></svg>',
    };
    document.querySelectorAll("#bpt-calculator .bpt__choice-icon, #bpt-calculator .bpt__package-icon").forEach((el) => {
      const key = el.getAttribute("data-icon") || (el.closest("[data-tier]")?.getAttribute("data-tier") === "premium" ? "combi" : "combi");
      el.innerHTML = ICONS[key] || ICONS.combi;
    });

    // --- Pricing. See the comment at the top of this file. ---
    const BASE_PRICE = { likeForLike: 2500, conversion: 3500 };
    const TYPICAL_RANGE_MAX = 6000; // Steve's own stated ceiling — we never show more than this
    const PREMIUM_UPLIFT = 450; // assumption — confirm with Steve
    function sizeUplift(a) {
      let u = 0;
      if (a.bedrooms === "3–4") u += 300;
      if (a.bedrooms === "5+") u += 700;
      if (a.bathrooms === "2") u += 200;
      if (a.bathrooms === "3+") u += 500;
      return u;
    }
    function recommendSystem(a) {
      if (a.situation === "Replace a broken boiler, like-for-like" && a.systemType && a.systemType !== "Not sure") {
        return a.systemType;
      }
      const bigHome = a.bedrooms === "5+" || a.bathrooms === "3+";
      return bigHome ? "System boiler (with a cylinder)" : "Combi boiler";
    }
    function isLikeForLike(a, recommended) {
      if (a.situation === "Replace a broken boiler, like-for-like") return true;
      return !!(a.systemType && a.systemType !== "Not sure" && a.systemType === recommended);
    }
    function gbp(n) {
      return "£" + Math.round(n).toLocaleString("en-GB");
    }

    const root = document.getElementById("bpt-calculator");
    if (!root) return;
    const panels = Array.from(root.querySelectorAll(".bpt__panel"));
    const fill = root.querySelector(".bpt__progress-fill");
    const track = root.querySelector(".bpt__progress-track");
    const counter = root.querySelector(".bpt__stepcount-current");
    const diagnosticTotal = panels.filter((p) => p.dataset.panel && p.dataset.panel.startsWith("step-")).length;
    const answers = {};
    let selectedTier = "premium";
    let index = 0;

    function show(newIndex) {
      panels[index].classList.remove("is-active");
      index = newIndex;
      panels[index].classList.add("is-active");
      const panelName = panels[index].dataset.panel || "";
      root.classList.toggle("bpt--started", index > 0);
      const onDiagnosticStep = panelName.startsWith("step-");
      const stepNum = onDiagnosticStep ? Number(panelName.split("-")[1]) + 1 : diagnosticTotal;
      const pct = Math.round((Math.min(stepNum, diagnosticTotal) / diagnosticTotal) * 100);
      fill.style.width = pct + "%";
      if (track) track.setAttribute("aria-valuenow", String(stepNum));
      if (counter) counter.textContent = String(Math.min(stepNum, diagnosticTotal));
      panels[index].querySelector("input")?.focus();
    }

    root.querySelector(".bpt__start")?.addEventListener("click", () => show(1));

    panels.forEach((panel, i) => {
      panel.querySelectorAll(".bpt__choice").forEach((btn) => {
        btn.addEventListener("click", () => {
          const key = panel.getAttribute("data-key");
          answers[key] = btn.getAttribute("data-value");
          if (key === "boilerAge") {
            renderResult();
          }
          show(i + 1);
        });
      });
      panel.querySelector(".bpt__back")?.addEventListener("click", () => {
        if (panel.dataset.panel === "quote") {
          const resultIdx = panels.findIndex((p) => p.dataset.panel === "result");
          show(resultIdx);
        } else {
          show(Math.max(0, i - 1));
        }
      });
    });

    root.querySelector(".bpt__restart")?.addEventListener("click", () => {
      Object.keys(answers).forEach((k) => delete answers[k]);
      show(0);
    });

    function renderResult() {
      const recommended = recommendSystem(answers);
      const base = isLikeForLike(answers, recommended) ? BASE_PRICE.likeForLike : BASE_PRICE.conversion;
      const uplift = sizeUplift(answers);
      const essential = Math.min(base + uplift, TYPICAL_RANGE_MAX);
      const premium = Math.min(essential + PREMIUM_UPLIFT, TYPICAL_RANGE_MAX);

      const resultPanel = root.querySelector('[data-panel="result"]');
      resultPanel.querySelector(".bpt__result-system").textContent = recommended.replace(/\s*\(.*\)/, "");
      resultPanel.querySelector(".bpt__result-sub").textContent =
        recommended.startsWith("Combi")
          ? "A combi gives you hot water on demand with no tank to run out — a good fit for what you've told us."
          : "Keeping a cylinder gives you steady pressure to more than one bathroom at once.";

      const essentialIcon = recommended.startsWith("System") ? "cylinder" : recommended.startsWith("Regular") ? "radiator" : "combi";
      resultPanel.querySelectorAll(".bpt__package").forEach((card) => {
        const tier = card.dataset.tier;
        const price = tier === "essential" ? essential : premium;
        card.querySelector(".bpt__package-price").textContent = "From " + gbp(price);
        const iconEl = card.querySelector(".bpt__package-icon");
        iconEl.innerHTML = ICONS[essentialIcon] || ICONS.combi;
        card.addEventListener("click", () => { selectedTier = tier; });
      });
    }

    root.querySelector(".bpt__want-quote")?.addEventListener("click", () => {
      const quoteIdx = panels.findIndex((p) => p.dataset.panel === "quote");
      show(quoteIdx);
    });

    const contactForm = root.querySelector(".bpt__contact-form");
    contactForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(contactForm);
      answers.name = fd.get("name");
      answers.email = fd.get("email");
      answers.phone = fd.get("phone");

      const submitBtn = contactForm.querySelector(".bpt__submit");
      submitBtn.disabled = true;
      submitBtn.textContent = "Sending…";

      const payload = {
        magnetId: "boiler-price-calculator",
        sourcePage,
        submittedAt: new Date().toISOString(),
        answers,
        selectedTier,
      };

      if (webhookUrl) {
        try {
          await fetch(webhookUrl, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
        } catch (err) {
          console.warn("Lead capture webhook failed — continuing anyway:", err);
        }
      } else {
        console.warn("[boiler-price-tool] No leadWebhookUrl configured — this submission was not captured anywhere:", payload);
      }

      const sentPanel = root.querySelector('[data-panel="sent"]');
      sentPanel.querySelector(".bpt__sent-name").textContent = String(answers.name || "").split(" ")[0] || "there";
      sentPanel.querySelector(".bpt__sent-phone").textContent = String(answers.phone || phoneDisplay);
      show(panels.findIndex((p) => p.dataset.panel === "sent"));
    });
  })();
</script>

<style>
  .visually-hidden {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;
  }
  .bpt {
    max-width: 680px;
    margin: 0 auto;
    background: var(--color-white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: 2rem 1.75rem 2.25rem;
  }
  .bpt__progress-track {
    height: 6px;
    background: var(--color-grey-100);
    border-radius: 999px;
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .bpt.bpt--started .bpt__progress-track { opacity: 1; }
  .bpt__stepcount { opacity: 0; transition: opacity 0.25s ease; margin: 0.5rem 0 1.5rem; font-size: 0.78rem; color: var(--color-grey-600); font-weight: 600; }
  .bpt.bpt--started .bpt__stepcount { opacity: 1; }
  .bpt__progress-fill {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--color-orange-500), var(--color-orange-400));
    border-radius: 999px;
    transition: width 0.35s ease;
  }
  .bpt__stage { position: relative; }
  .bpt__panel { display: none; animation: bptFadeIn 0.3s ease; }
  .bpt__panel.is-active { display: block; }
  @keyframes bptFadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .bpt__intro { font-size: 1.05rem; color: var(--color-grey-900); margin: 0 0 1.5rem; line-height: 1.55; }
  .bpt__question { font-size: 1.3rem; margin: 0 0 1.25rem; color: var(--color-navy-900); }
  .bpt__choices { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.7rem; margin-bottom: 1rem; }
  .bpt__choices[data-count="3"] { grid-template-columns: repeat(3, 1fr); }
  .bpt__choice {
    display: flex; flex-direction: column; align-items: center; text-align: center; gap: 0.6rem;
    font: inherit; font-size: 0.92rem; font-weight: 600;
    padding: 1.1em 0.8em;
    border: 2px solid var(--color-grey-100);
    background: var(--color-off-white);
    border-radius: var(--radius-md);
    cursor: pointer;
    color: var(--color-grey-900);
    transition: border-color 0.15s ease, background 0.15s ease, transform 0.1s ease;
  }
  .bpt__choice:hover { border-color: var(--color-orange-400); background: var(--color-white); }
  .bpt__choice:active { transform: scale(0.99); }
  .bpt__choice-icon { width: 2rem; height: 2rem; color: var(--color-orange-500); }
  .bpt__choice-icon :global(svg) { width: 100%; height: 100%; }
  @media (max-width: 480px) {
    .bpt__choices { grid-template-columns: repeat(2, 1fr) !important; }
  }
  .bpt__back {
    background: none; border: none; font: inherit; font-size: 0.85rem;
    color: var(--color-grey-600); cursor: pointer; padding: 0.4em 0; text-decoration: underline;
  }

  .bpt__result-eyebrow {
    text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.78rem;
    font-weight: 700; color: var(--color-orange-500); margin: 0 0 0.4rem;
  }
  .bpt__result-heading { margin-bottom: 0.3rem; }
  .bpt__result-system { color: var(--color-orange-500); }
  .bpt__result-sub { color: var(--color-grey-600); margin: 0 0 1.5rem; }

  .bpt__packages { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; margin-bottom: 1rem; }
  @media (max-width: 560px) { .bpt__packages { grid-template-columns: 1fr; } }
  .bpt__package {
    border: 2px solid var(--color-grey-100);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.1rem;
    position: relative;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }
  .bpt__package:hover { border-color: var(--color-orange-400); }
  .bpt__package--featured { border-color: var(--color-orange-500); background: var(--color-off-white); }
  .bpt__package-badge {
    display: inline-block; font-size: 0.72rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.04em; color: var(--color-white); background: var(--color-orange-500);
    border-radius: 999px; padding: 0.25em 0.75em; margin-bottom: 0.75rem;
  }
  .bpt__package-badge--muted { background: var(--color-navy-800); }
  .bpt__package-icon { display: block; width: 2.25rem; height: 2.25rem; color: var(--color-navy-800); margin-bottom: 0.5rem; }
  .bpt__package-icon :global(svg) { width: 100%; height: 100%; }
  .bpt__package-brand { font-size: 0.82rem; color: var(--color-grey-600); margin: 0 0 0.35rem; }
  .bpt__package-price { font-size: 1.6rem; font-weight: 800; color: var(--color-navy-900); margin: 0 0 0.75rem; }
  .bpt__package-features { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.4rem; font-size: 0.85rem; color: var(--color-grey-900); }
  .bpt__package-features li { padding-left: 1.3em; position: relative; }
  .bpt__package-features li::before { content: "✓"; position: absolute; left: 0; color: var(--color-success); font-weight: 700; }

  .bpt__result-footnote { font-size: 0.82rem; color: var(--color-grey-600); margin: 0 0 1.5rem; }
