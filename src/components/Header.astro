---
import { siteConfig, primaryNav } from "../data/siteConfig";
---
<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__logo">
      <img
        src="/images/logo-icon.png"
        alt=""
        class="site-header__logo-icon"
        width="41"
        height="48"
        loading="eager"
      />
      <span class="site-header__logo-text">
        <span class="site-header__logo-dark">The Boiler</span> <span class="site-header__logo-accent">Doctor</span>
      </span>
      <span class="visually-hidden">— {siteConfig.businessName}, home</span>
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul>
        {primaryNav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="site-header__cta">
      <a href={siteConfig.phoneHref} class="btn btn--secondary btn--sm">Call {siteConfig.phoneDisplay}</a>
      <a href="/book-online/" class="btn btn--primary btn--sm">Book Online</a>
    </div>

    <button
      type="button"
      class="site-header__toggle"
      aria-expanded="false"
      aria-controls="mobile-nav"
      id="mobile-nav-toggle"
    >
      <span class="visually-hidden">Open menu</span>
      <span class="site-header__toggle-bars" aria-hidden="true"></span>
    </button>
  </div>

  <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile" hidden>
    <ul>
      {primaryNav.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
    </ul>
    <a href={siteConfig.phoneHref} class="btn btn--secondary btn--block">Call {siteConfig.phoneDisplay}</a>
  </nav>
</header>

<script>
  const toggle = document.getElementById("mobile-nav-toggle");
  const nav = document.getElementById("mobile-nav");
  if (toggle && nav) {
    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!isOpen));
      nav.hidden = isOpen;
      document.body.classList.toggle("mobile-nav-open", !isOpen);
    });
    // Close the menu when a link inside it is clicked (route change)
    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        toggle.setAttribute("aria-expanded", "false");
        nav.hidden = true;
        document.body.classList.remove("mobile-nav-open");
      });
    });
  }
</script>

<style>
  .site-header {
    background: rgba(255, 255, 255, 0.78);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    position: sticky;
    top: 0;
    z-index: 40;
  }
  .site-header::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    height: 22px;
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0));
    pointer-events: none;
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.85rem;
  }
  .site-header__logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 800;
    font-size: 1.15rem;
    text-decoration: none;
    white-space: nowrap;
    margin-right: 1.5rem;
    flex-shrink: 0;
  }
  .site-header__logo-icon {
    height: 40px;
    width: auto;
    display: block;
    flex-shrink: 0;
  }
  .site-header__logo-dark { color: var(--color-navy-900); }
  .site-header__logo-accent { color: var(--color-orange-600); }
  .site-header__nav { display: none; }
  .site-header__nav ul {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-header__nav a {
    text-decoration: none;
    color: var(--color-navy-800);
    font-weight: 600;
    font-size: 0.92rem;
  }
  .site-header__nav a:hover { color: var(--color-orange-600); }
  .site-header__cta { display: none; gap: 0.6rem; }
  .btn--sm { padding: 0.6em 1em; font-size: 0.88rem; }

  .site-header__toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-grey-300);
    background: var(--color-white);
    cursor: pointer;
  }
  .site-header__toggle-bars,
  .site-header__toggle-bars::before,
  .site-header__toggle-bars::after {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--color-navy-900);
    position: relative;
    transition: transform 0.15s ease;
  }
  .site-header__toggle-bars::before { content: ""; position: absolute; top: -6px; }
  .site-header__toggle-bars::after { content: ""; position: absolute; top: 6px; }
  .site-header__toggle[aria-expanded="true"] .site-header__toggle-bars { background: transparent; }
  .site-header__toggle[aria-expanded="true"] .site-header__toggle-bars::before { transform: translateY(6px) rotate(45deg); }
  .site-header__toggle[aria-expanded="true"] .site-header__toggle-bars::after { transform: translateY(-6px) rotate(-45deg); }

  .mobile-nav {
    border-top: 1px solid var(--color-grey-100);
    padding: 1.25rem;
    padding-bottom: calc(1.25rem + var(--sticky-bar-height, 60px));
    background: var(--color-white);
    max-height: calc(100vh - 70px);
    overflow-y: auto;
  }
  .mobile-nav ul {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    display: grid;
    gap: 0.25rem;
  }
  .mobile-nav a {
    display: block;
    padding: 0.7em 0.25em;
    text-decoration: none;
    color: var(--color-navy-900);
    font-weight: 700;
    font-size: 1.05rem;
    border-bottom: 1px solid var(--color-grey-100);
  }

  @media (min-width: 1080px) {
    .site-header__nav { display: block; }
    .site-header__cta { display: flex; }
    .site-header__toggle { display: none; }
    .mobile-nav { display: none; }
  }
</style>
