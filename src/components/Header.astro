---
import { siteConfig, primaryNav } from "../data/siteConfig";
---
<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__logo">
      {siteConfig.businessName}
      <span class="visually-hidden">— home</span>
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul>
        {primaryNav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="site-header__cta">
      <a href={siteConfig.phoneHref} class="btn btn--secondary btn--sm">Call {siteConfig.phoneDisplay}</a>
      <a href="/book-online/" class="btn btn--primary btn--sm">Book Online</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-grey-100);
    background: var(--color-white);
    position: sticky;
    top: 0;
    z-index: 40;
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.85rem;
  }
  .site-header__logo {
    font-weight: 800;
    font-size: 1.15rem;
    color: var(--color-navy-900);
    text-decoration: none;
    white-space: nowrap;
  }
  .site-header__nav { display: none; }
  .site-header__nav ul {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-header__nav a {
    text-decoration: none;
    color: var(--color-navy-800);
    font-weight: 600;
    font-size: 0.92rem;
  }
  .site-header__nav a:hover { color: var(--color-orange-600); }
  .site-header__cta { display: none; gap: 0.6rem; }
  .btn--sm { padding: 0.6em 1em; font-size: 0.88rem; }

  @media (min-width: 1080px) {
    .site-header__nav { display: block; }
    .site-header__cta { display: flex; }
  }
</style>
