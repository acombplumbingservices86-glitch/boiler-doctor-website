---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTABand from "../../components/CTABand.astro";
import NeedsInput from "../../components/NeedsInput.astro";

const title = "Boiler & Heating Advice | The Boiler Doctor, York";
const description = "Honest, jargon-free advice on boilers, heating and air conditioning from York's own Boiler Doctor.";

const articles = [
  "How much does a new boiler actually cost?",
  "Combi vs system boiler — which do I need?",
  "Why is my boiler losing pressure?",
  "Do I really need an annual service?",
  "What does a CP12 landlord certificate cover?",
  "Signs you need a power flush, not just a bleed",
];
---
<BaseLayout title={title} description={description}>
  <section class="section">
    <div class="container">
      <h1>Straight Answers, No Sales Pitch</h1>
      <p class="lede">Practical advice on the questions we actually get asked, every day, by real customers.</p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="grid grid--3">
        {articles.map((a) => (
          <div class="card">
            <h3>{a}</h3>
            <NeedsInput label="Article content to be written — seeded from real call-transcript themes, once core sitemap pages are live." />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow lead-magnet">
      <h2>Thinking about a new boiler?</h2>
      <p>Get our free guide.</p>
      <a href="/new-boiler-installation/" class="btn btn--primary">Get the guide</a>
    </div>
  </section>

  <CTABand heading="Still not sure? Just ask us directly." />
</BaseLayout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-grey-600); max-width: 48ch; }
  .narrow { max-width: 68ch; text-align: center; }
</style>
