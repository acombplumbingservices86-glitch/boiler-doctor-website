---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTABand from "../../components/CTABand.astro";
import NeedsInput from "../../components/NeedsInput.astro";
import { siteConfig } from "../../data/siteConfig";

const title = "Boiler & Heating Advice | The Boiler Doctor, York";
const description = "Honest, jargon-free advice on boilers, heating and air conditioning from York's own Boiler Doctor.";

const generalArticles = [
  { title: "How much does a new boiler actually cost?", href: "/advice-centre/new-boiler-cost/" },
  { title: "Combi vs system boiler — which do I need?", href: "/advice-centre/combi-vs-system-boiler/" },
  { title: "Why is my boiler losing pressure?", href: "/advice-centre/why-is-my-boiler-losing-pressure/" },
  { title: "Do I really need an annual service?", href: "/advice-centre/do-i-need-annual-service/" },
  { title: "What does a CP12 landlord certificate cover?", href: "/advice-centre/cp12-landlord-certificate/" },
  { title: "Signs you need a power flush, not just a bleed", href: "/advice-centre/signs-you-need-power-flush/" },
];

const areaArticles = siteConfig.serviceAreas.flatMap((name) => {
  const slug = name.toLowerCase();
  return [
    { title: `Boiler advice for ${name} homeowners`, href: `/advice-centre/boiler-advice-${slug}/` },
    { title: `Air conditioning advice for ${name}`, href: `/advice-centre/air-conditioning-advice-${slug}/` },
  ];
});

const articles = [...generalArticles, ...areaArticles];
---
<BaseLayout title={title} description={description}>
  <section class="section">
    <div class="container">
      <h1>Straight Answers, No Sales Pitch</h1>
      <p class="lede">Practical advice on the questions we actually get asked, every day, by real customers.</p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="grid grid--3">
        {articles.map((a) => (
          a.href ? (
            <a href={a.href} class="card article-tile">
              <h3>{a.title}</h3>
              <span class="article-tile__link">Read the guide →</span>
            </a>
          ) : (
            <div class="card">
              <h3>{a.title}</h3>
              <NeedsInput label="Article not written yet — coming as the Advice Centre grows." />
            </div>
          )
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow lead-magnet">
      <h2>Thinking about a new boiler?</h2>
      <p>Two quick questions and we'll give you a straight ballpark price.</p>
      <a href="/guides/boiler-price-estimate/" class="btn btn--primary">Get the free price estimate</a>
    </div>
  </section>

  <CTABand heading="Still not sure? Just ask us directly." />
</BaseLayout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-grey-600); max-width: 48ch; }
  .narrow { max-width: 68ch; text-align: center; }
  .article-tile { text-decoration: none; color: inherit; display: block; }
  .article-tile__link { color: var(--color-orange-600); font-weight: 700; font-size: 0.9rem; }
</style>
