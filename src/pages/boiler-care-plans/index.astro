---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTABand from "../../components/CTABand.astro";
import TrustStrip from "../../components/TrustStrip.astro";
import { siteConfig } from "../../data/siteConfig";

const title = "Boiler Care Plans from £12.99/month | The Boiler Doctor, York";
const description =
  "Annual service, priority callouts and repair cover from £12.99/month. Three plans, no small print surprises. Compare and join online.";

const plans = [
  {
    name: "The Checkup",
    price: "£12.99/mo",
    priceYear: "or £140/yr",
    features: [
      "Annual service (from year two)",
      "CP12 gas safety check",
      "Boiler health report",
      "Free CO alarm",
    ],
    joinUrl: "https://link.fastpaydirect.com/payment-link/6aae23539f7ff2c808a76766",
  },
  {
    name: "On Call",
    price: "£16.99/mo",
    priceYear: "or £183/yr",
    features: [
      "Everything in The Checkup",
      "24-hour priority booking",
      "10% off repairs",
      "Free 3D-printed radiator key",
    ],
    highlight: true,
    joinUrl: "https://link.fastpaydirect.com/payment-link/6aae241df426560dbc2f121d",
  },
  {
    name: "House Call",
    price: "£24.99/mo",
    priceYear: "or £270/yr",
    features: [
      "Everything in On Call",
      "Free callout (£120 value)",
      "£250/yr parts & labour cover",
      "Controls/thermostat inspection",
      "Radiator maintenance",
      "No excess",
      "Dedicated phone line",
      "Branded mug",
    ],
    joinUrl: "https://link.fastpaydirect.com/payment-link/6aae2507f426560dbc2f121e",
  },
];
---
<BaseLayout title={title} description={description}>
  <section class="section">
    <div class="container">
      <h1>Never Get Caught Out By a Cold House Again</h1>
      <p class="lede">Three simple care plans. Pick the level of cover that suits your home.</p>
    </div>
    <div class="container">
      <TrustStrip />
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="grid grid--3 plans">
        {plans.map((plan) => (
          <div class={`card plan-card ${plan.highlight ? "plan-card--highlight" : ""}`}>
            <h2>{plan.name}</h2>
            <p class="plan-card__price">{plan.price} <span>{plan.priceYear}</span></p>
            <ul>
              {plan.features.map((f) => <li>{f}</li>)}
            </ul>
            <button
              type="button"
              class="btn btn--primary btn--block js-join-plan"
              data-plan-name={plan.name}
              data-pay-url={plan.joinUrl}
            >
              Join {plan.name}
            </button>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTABand
    heading="Pick your plan, we'll take it from there."
    subheading="Questions first? Call or WhatsApp us any time — no obligation."
  />

  <div class="plan-modal-backdrop" id="planModalBackdrop" hidden>
    <div class="plan-modal" role="dialog" aria-modal="true" aria-labelledby="planModalTitle">
      <button type="button" class="plan-modal__close" id="planModalClose" aria-label="Close">&times;</button>
      <h2 id="planModalTitle">Joining <span id="planModalPlanName">a plan</span></h2>
      <p class="plan-modal__question">Have you already had your boiler serviced by Steve or The Boiler Doctor?</p>
      <div class="plan-modal__actions">
        <a id="planModalNo" href="#" class="btn btn--secondary">
          No — I need to book my first service
        </a>
        <a id="planModalYes" href="#" class="btn btn--primary">
          Yes — take me to payment
        </a>
      </div>
      <p class="plan-modal__note">
        New to a plan? Book your first annual service and your first month's payment comes
        straight off that invoice on the day — so signing up costs you nothing extra.
      </p>
    </div>
  </div>
</BaseLayout>

<script define:vars={{ bookingUrl: siteConfig.carePlanBookingUrl }}>
  const backdrop = document.getElementById("planModalBackdrop");
  const closeBtn = document.getElementById("planModalClose");
  const planNameEl = document.getElementById("planModalPlanName");
  const noBtn = document.getElementById("planModalNo");
  const yesBtn = document.getElementById("planModalYes");
  let lastFocused = null;

  function openModal(planName, payUrl) {
    planNameEl.textContent = planName;
    noBtn.href = bookingUrl;
    yesBtn.href = payUrl;
    lastFocused = document.activeElement;
    backdrop.hidden = false;
    closeBtn.focus();
    document.addEventListener("keydown", onKeydown);
  }

  function closeModal() {
    backdrop.hidden = true;
    document.removeEventListener("keydown", onKeydown);
    if (lastFocused) lastFocused.focus();
  }

  function onKeydown(e) {
    if (e.key === "Escape") closeModal();
  }

  document.querySelectorAll(".js-join-plan").forEach((btn) => {
    btn.addEventListener("click", () => {
      openModal(btn.dataset.planName, btn.dataset.payUrl);
    });
  });

  closeBtn.addEventListener("click", closeModal);
  backdrop.addEventListener("click", (e) => {
    if (e.target === backdrop) closeModal();
  });
</script>

<style>
  .lede { font-size: 1.1rem; color: var(--color-grey-600); max-width: 48ch; }
  .narrow { max-width: 68ch; }
  .plan-card { display: flex; flex-direction: column; gap: 0.75rem; }
  .plan-card h2 { font-size: clamp(1.15rem, 2vw, 1.4rem); } /* visually matches the old h3 size — only the semantic level changed, to fix a heading-order a11y gap */
  .plan-card--highlight { border: 2px solid var(--color-orange-500); }
  .plan-card__price { font-size: 1.6rem; font-weight: 800; color: var(--color-navy-900); }
  .plan-card__price span { font-size: 0.9rem; font-weight: 500; color: var(--color-grey-600); }
  .plan-card ul { list-style: none; padding: 0; margin: 0; flex-grow: 1; display: grid; gap: 0.4rem; }
  .plan-card li { padding-left: 1.4em; position: relative; font-size: 0.92rem; }
  .plan-card li::before { content: "✓"; position: absolute; left: 0; color: var(--color-success); font-weight: 700; }

  .plan-modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(11, 31, 58, 0.55);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    z-index: 100;
  }
  .plan-modal-backdrop[hidden] { display: none; }
  .plan-modal {
    position: relative;
    background: #fff;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    max-width: 30rem;
    width: 100%;
    padding: 2rem 1.75rem 1.75rem;
  }
  .plan-modal h2 { margin: 0 0 0.75rem; font-size: 1.3rem; color: var(--color-navy-900); }
  .plan-modal__question { font-weight: 600; color: var(--color-navy-800); margin: 0 0 1.25rem; }
  .plan-modal__actions { display: grid; gap: 0.6rem; }
  .plan-modal__note { font-size: 0.85rem; color: var(--color-grey-600); margin: 1.25rem 0 0; line-height: 1.5; }
  .plan-modal__close {
    position: absolute;
    top: 0.75rem;
    right: 0.9rem;
    background: none;
    border: none;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--color-grey-600);
    cursor: pointer;
    padding: 0.25rem;
  }
  .plan-modal__close:hover { color: var(--color-navy-900); }
</style>
