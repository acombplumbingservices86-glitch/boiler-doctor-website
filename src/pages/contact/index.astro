---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NeedsInput from "../../components/NeedsInput.astro";
import { siteConfig } from "../../data/siteConfig";

const title = "Contact The Boiler Doctor | York";
const description = "Get in touch by phone, WhatsApp or email. We usually reply the same day.";
---
<BaseLayout title={title} description={description}>
  <section class="section">
    <div class="container">
      <h1>Get in Touch</h1>
      <p class="lede">Hayden picks up most calls and emails — website enquiries come straight through to Steve.</p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container contact-grid">
      <div class="card">
        <h2>Contact details</h2>
        <p>
          <strong>Phone:</strong> <a href={siteConfig.phoneHref}>{siteConfig.phoneDisplay}</a><br />
          <strong>Email:</strong> <a href={siteConfig.emailHref}>{siteConfig.emailDisplay}</a><br />
          <strong>WhatsApp:</strong> {siteConfig.whatsappReady
            ? <a href={`https://wa.me/${siteConfig.whatsappNumberIntl}`}>{siteConfig.whatsappDisplay}</a>
            : <>{siteConfig.whatsappDisplay} (coming soon)</>}<br />
          <strong>Office hours:</strong> {siteConfig.officeHours}
        </p>
      </div>

      <div class="card">
        <h2>Send a message</h2>
        <NeedsInput label="Phase Four build: form here routes into GHL, tagged by service interest (see file 18)." />
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container narrow">
      <h2>Follow along</h2>
      <p>Boiler tips, job walkthroughs and the odd podcast appearance — follow The Boiler Doctor for more.</p>
      <div class="social-links">
        {siteConfig.socials.facebook && (
          <a href={siteConfig.socials.facebook} class="social-link social-link--facebook">
            <span aria-hidden="true">📘</span> Facebook
          </a>
        )}
        {siteConfig.socials.youtube && (
          <a href={siteConfig.socials.youtube} class="social-link social-link--youtube">
            <span aria-hidden="true">▶️</span> YouTube
          </a>
        )}
        {siteConfig.socials.instagram && (
          <a href={siteConfig.socials.instagram} class="social-link social-link--instagram">
            <span aria-hidden="true">📷</span> Instagram
          </a>
        )}
        {siteConfig.socials.tiktok && (
          <a href={siteConfig.socials.tiktok} class="social-link social-link--tiktok">
            <span aria-hidden="true">🎵</span> TikTok
          </a>
        )}
      </div>
      {siteConfig.featuredVideos.length > 0 && (
        <div class="featured-videos">
          <h3>Worth a watch</h3>
          <ul>
            {siteConfig.featuredVideos.map((v) => (
              <li><a href={v.url}>{v.label}</a></li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container narrow fine-print">
      <p>
        {siteConfig.address.line1}, {siteConfig.address.line2}, {siteConfig.address.city} {siteConfig.address.postcode}<br />
        {siteConfig.legalName} · Company No. {siteConfig.companyNumber} · VAT No. {siteConfig.vatNumber}
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-grey-600); max-width: 48ch; }
  .contact-grid { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  .narrow { max-width: 68ch; }
  .fine-print { font-size: 0.85rem; color: var(--color-grey-600); }
  .social-links { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1rem; }
  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-weight: 700;
    font-size: 0.98rem;
    padding: 0.75em 1.25em;
    border-radius: var(--radius-md);
    background: var(--color-white);
    color: var(--color-navy-800);
    box-shadow: var(--shadow-card);
    text-decoration: none;
  }
  .social-link:hover { background: var(--color-grey-100); }
  .featured-videos { margin-top: 2rem; }
  .featured-videos ul { list-style: none; padding: 0; display: grid; gap: 0.5rem; }
  .featured-videos li { background: var(--color-white); border-radius: var(--radius-sm); padding: 0.7em 1em; box-shadow: var(--shadow-card); }
</style>
