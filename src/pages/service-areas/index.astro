---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTABand from "../../components/CTABand.astro";
import { siteConfig } from "../../data/siteConfig";

const title = "Areas We Cover | Boiler & Heating Engineers in York";
const description = "Covering Acomb, York and surrounding villages. See the full list of areas we serve.";

const areas = siteConfig.serviceAreas.map((name) => {
  const slug = name.toLowerCase();
  return {
    name,
    links: [
      { label: "New boiler installation", href: `/new-boiler-installation-${slug}/` },
      { label: "Boiler repairs & breakdowns", href: `/boiler-repairs-${slug}/` },
      { label: "Boiler servicing", href: `/boiler-servicing-${slug}/` },
      { label: `${name} boiler advice guide`, href: `/advice-centre/boiler-advice-${slug}/` },
      { label: "Domestic air conditioning", href: `/air-conditioning-domestic-${slug}/` },
      { label: "Split system air conditioning", href: `/air-conditioning-split-systems-${slug}/` },
      { label: "Air conditioning for small businesses", href: `/air-conditioning-commercial-${slug}/` },
      { label: `${name} air conditioning advice guide`, href: `/advice-centre/air-conditioning-advice-${slug}/` },
    ],
  };
});
---
<BaseLayout title={title} description={description}>
  <section class="section">
    <div class="container">
      <h1>Covering Acomb and All of York</h1>
      <p class="lede">Based in Acomb, working right across York and the surrounding area.</p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="area-grid">
        {siteConfig.serviceAreas.map((area) => (
          <span class="area-chip">{area}</span>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Dedicated pages for every area</h2>
      <p class="lede">Boilers and air conditioning, with a full page and an advice guide for each of the 20 areas we cover:</p>
      <div class="grid grid--3">
        {areas.map((area) => (
          <div class="card area-card">
            <h3>{area.name}</h3>
            <ul>
              {area.links.map((link) => (
                <li><a href={link.href}>{link.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <p>Not sure if we cover you? Just ask — <a href={siteConfig.phoneHref}>call {siteConfig.phoneDisplay}</a>.</p>
    </div>
  </section>

  <CTABand heading="Not sure if we cover you? Just ask." />
</BaseLayout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-grey-600); max-width: 48ch; }
  .narrow { max-width: 68ch; }
  .area-grid { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .area-chip {
    background: var(--color-white);
    border-radius: 999px;
    padding: 0.5em 1.1em;
    font-weight: 600;
    box-shadow: var(--shadow-card);
  }
  .area-card ul { list-style: none; padding: 0; margin: 0.75rem 0 0; display: grid; gap: 0.5rem; }
  .area-card a { font-weight: 600; }
</style>
