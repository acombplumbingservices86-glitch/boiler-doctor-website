---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTABand from "../../components/CTABand.astro";
import TrustStrip from "../../components/TrustStrip.astro";
import { siteConfig } from "../../data/siteConfig";

const title = "Annual Boiler Service in Copmanthorpe from £100 + VAT | The Boiler Doctor";
const description = "Book an annual boiler service in Copmanthorpe. Gas Safe registered, protects your warranty. Call 01904 206190 or book online.";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": 'Do you do boiler servicing in Copmanthorpe?', "acceptedAnswer": { "@type": "Answer", "text": 'Yes — Copmanthorpe is one of our regular areas, the village on the edge of the city, southwest of York. We service boilers there every week of the year.' } },
    { "@type": "Question", "name": 'How much is a boiler service in Copmanthorpe?', "acceptedAnswer": { "@type": "Answer", "text": '£100 + VAT, with a written service record for your files and any warranty claim.' } }
  ],
};
---
<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <section class="section">
    <div class="container">
      <h1>Annual Boiler Service in Copmanthorpe</h1>
      <p class="lede">A proper annual boiler service for Copmanthorpe homes — the village on the edge of the city, southwest of York. Protects your warranty, catches problems early, keeps your gas safety certificate current.</p>
      <div class="hero__actions">
        <a href="/book-online/" class="btn btn--primary">Book a Service</a>
        <a href="/boiler-care-plans/" class="btn btn--secondary">Compare Care Plans</a>
      </div>
      <TrustStrip />
    </div>
  </section>

  <section class="section section--alt">
    <div class="container narrow">
      <h2>What's included</h2>
      <ul class="tick-list">
        <li>Full visual inspection</li>
        <li>Flue and ventilation check</li>
        <li>Gas pressure and burner check</li>
        <li>Safety device test</li>
        <li>CO alarm check</li>
        <li>Written service record for your files and any warranty claim</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>Price</h2>
      <p class="price-highlight">£100 + VAT</p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container narrow">
      <h2>Common questions from Copmanthorpe homeowners</h2>
      <div class="faq-list">
    <details class="faq-item">
      <summary>Do you do boiler servicing in Copmanthorpe?</summary>
      <p>Yes — Copmanthorpe is one of our regular areas, the village on the edge of the city, southwest of York. We service boilers there every week of the year.</p>
    </details>
    <details class="faq-item">
      <summary>How much is a boiler service in Copmanthorpe?</summary>
      <p>£100 + VAT, with a written service record for your files and any warranty claim.</p>
    </details>
      </div>
      <p><a href="/advice-centre/do-i-need-annual-service/">Read the full honest case for servicing every year →</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow card care-cross-sell">
      <h2>If you're doing this every year anyway...</h2>
      <p>Our Checkup plan works out cheaper than a one-off service and throws in a free CO alarm.</p>
      <a href="/boiler-care-plans/" class="btn btn--primary">See Care Plans</a>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container narrow">
      <h2>More on Copmanthorpe</h2>
      <p>Read our <a href="/advice-centre/boiler-advice-copmanthorpe/">Copmanthorpe boiler advice guide</a>, or see our <a href="/new-boiler-installation-copmanthorpe/">new boiler installation</a> and <a href="/boiler-repairs-copmanthorpe/">boiler repairs</a> pages for Copmanthorpe.</p>
      <p class="nearby">Also covering: <a href="/boiler-servicing-dringhouses/">Dringhouses</a> · <a href="/boiler-servicing-bishopthorpe/">Bishopthorpe</a> · <a href="/boiler-servicing-acomb/">Acomb</a> · <a href="/service-areas/">see all 20 areas we cover →</a></p>
    </div>
  </section>

  <CTABand heading="Book your Copmanthorpe service before winter catches you out." />
</BaseLayout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-grey-600); max-width: 48ch; }
  .hero__actions { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1.25rem; }
  .narrow { max-width: 68ch; }
  .tick-list { list-style: none; padding: 0; display: grid; gap: 0.5rem; }
  .tick-list li { padding-left: 1.6em; position: relative; }
  .tick-list li::before { content: "✅"; position: absolute; left: 0; }
  .price-highlight { font-size: 2.5rem; font-weight: 800; color: var(--color-orange-600); }
  .care-cross-sell { text-align: center; }
  .faq-list { display: grid; gap: 0.75rem; }
  .faq-item { background: var(--color-white); border-radius: var(--radius-md); padding: 1rem 1.25rem; box-shadow: var(--shadow-card); }
  .faq-item summary { font-weight: 700; cursor: pointer; }
  .faq-item p { margin: 0.6em 0 0; color: var(--color-grey-600); }
  .nearby { font-size: 0.9rem; color: var(--color-grey-600); }
</style>
