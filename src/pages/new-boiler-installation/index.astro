---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTABand from "../../components/CTABand.astro";
import TrustStrip from "../../components/TrustStrip.astro";
import LeadMagnetForm from "../../components/LeadMagnetForm.astro";
import { siteConfig } from "../../data/siteConfig";

const priceGuideSteps = [
  {
    key: "systemType",
    type: "choice",
    question: "What type of system do you have?",
    options: ["Combi boiler", "System boiler (with a cylinder)", "Regular / heat-only boiler", "Not sure"],
  },
  {
    key: "situation",
    type: "choice",
    question: "What are you looking to do?",
    options: ["Replace a broken boiler, like-for-like", "Upgrade to a different system type", "Not sure yet — just exploring"],
  },
  {
    key: "bedrooms",
    type: "choice",
    question: "How many bedrooms in the property?",
    options: ["1–2", "3–4", "5+"],
  },
  {
    key: "bathrooms",
    type: "choice",
    question: "How many bathrooms or showers might run at the same time?",
    options: ["1", "2", "3+"],
  },
  {
    key: "boilerAge",
    type: "choice",
    question: "How old is your current boiler?",
    options: ["Under 10 years", "10–15 years", "15+ years", "No boiler yet"],
  },
];

const priceGuideResultHtml = `
  <p>Based on what you've told us — <strong>{{answers.systemType}}</strong>, {{answers.situation}}, {{answers.bedrooms}} bedrooms, {{answers.bathrooms}} bathroom(s):</p>
  <ul>
    <li>A <strong>like-for-like combi swap</strong> starts from <strong>£2,000</strong></li>
    <li>A <strong>system-to-combi conversion</strong> starts from <strong>£3,000</strong></li>
    <li>Typical range for most jobs: <strong>£2,000–£5,000</strong>, depending on what's involved</li>
  </ul>
  <p>That's a solid starting point — the exact number depends on the boiler and what's already in the house. We'll follow up with a proper written quote after a free home visit. No obligation, no pressure to buy bigger than you need.</p>
`;

const title = "New Boiler Installation in York | Worcester Bosch & Ideal Specialists";
const description =
  "New boilers from £2,000, typically £2,000-£5,000 fitted. Worcester Bosch and Ideal accredited installer. Honest advice, no pressure. Call 01904 206190.";
---
<BaseLayout title={title} description={description}>
  <section class="section">
    <div class="container">
      <h1>A New Boiler, Fitted by People Who'll Still Be Around Next Year</h1>
      <p class="lede">Worcester Bosch and Ideal accredited. Straight advice on what you actually need — not the biggest boiler we can sell you.</p>
      <div class="hero__actions">
        <a href="/book-online/" class="btn btn--primary">Book a Free Quote</a>
        <a href="tel:01904206190" class="btn btn--secondary">Call 01904 206190</a>
      </div>
    </div>
    <div class="container">
      <TrustStrip />
    </div>
  </section>

  <section class="section section--alt">
    <div class="container narrow">
      <h2>What it costs</h2>
      <ul class="price-list">
        <li><strong>Like-for-like combi swap:</strong> from £2,000</li>
        <li><strong>System-to-combi conversion:</strong> from £3,000</li>
        <li>Typical range £2,000–£5,000 depending on the job</li>
        <li>Deposit required on jobs over £1,000 (set out in your written quote); balance due on completion</li>
      </ul>
    </div>
    <div class="container install-gallery">
      <img src="/images/installs/install-mug.jpg" alt="Finished boiler installation with a Boiler Doctor branded folder and mug" loading="lazy" />
      <img src="/images/installs/install-cupboard.jpg" alt="Boiler neatly installed in a kitchen cupboard" loading="lazy" />
      <img src="/images/installs/install-bathroom.jpg" alt="Boiler installed in a bathroom with tiled floor" loading="lazy" />
      <img src="/images/installs/install-branded-folder.jpg" alt="Completed boiler installation with The Boiler Doctor's service record folder" loading="lazy" />
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>How we help you choose</h2>
      <p>Combi vs system vs regular/heat-only, sizing for your home and hot water demand, Worcester Bosch vs Ideal trade-offs, when a straight swap makes sense vs when the pipework needs work too. We'll answer your actual questions — not push a specific brand.</p>
      <p><a href="/advice-centre/combi-vs-system-boiler/">Read our honest combi vs system comparison →</a> · <a href="/advice-centre/new-boiler-cost/">See real pricing breakdowns →</a></p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container narrow">
      <h2>The process, start to finish</h2>
      <ol class="process-list">
        <li>Free home visit and quote</li>
        <li>Written proposal with clear pricing</li>
        <li>Agreed install date</li>
        <li>Typically 1 day for a like-for-like swap</li>
        <li>Gas Safe certificate and warranty registration handled for you</li>
        <li>Follow-up service reminder</li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>Real customer story</h2>
      <blockquote class="card review-card">
        <p>"100% recommended. We have used the Boiler Doctor for many years now. Totally reliable and honest. As always, a super friendly guy who did a great job in good time."</p>
        <footer>— James Reel, <span class="badge">New boiler</span></footer>
      </blockquote>
      <p><a href="/reviews/">Read all {siteConfig.reviews.count} reviews →</a></p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container narrow">
      <h2>Warranty</h2>
      <p>12 months' workmanship warranty from invoice date; manufacturer's boiler warranty runs separately (length confirmed at quote stage).</p>
      <p class="area-links">We've now got a dedicated page for every one of the 20 areas we cover — including <a href="/new-boiler-installation-woodthorpe/">Woodthorpe</a>, <a href="/new-boiler-installation-acomb/">Acomb</a> and <a href="/new-boiler-installation-york/">York</a> — see the <a href="/service-areas/">full list of areas</a>.</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow lead-magnet">
      <h2>Not sure what you need yet?</h2>
      <p>A few quick questions and we'll give you a straight ballpark figure — right here, no waiting on a callback.</p>
      <LeadMagnetForm
        magnetId="boiler-price-estimate-inline"
        intro="Takes about a minute. Tell us what you're working with, and we'll give you a straight ballpark."
        steps={priceGuideSteps}
        resultHeading="Here's your ballpark"
        resultBodyHtml={priceGuideResultHtml}
        sourcePage="/new-boiler-installation/"
      />
    </div>
  </section>

  <CTABand heading="Get a straight quote, no obligation." />
</BaseLayout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-grey-600); max-width: 48ch; }
  .hero__actions { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1.25rem; }
  .narrow { max-width: 68ch; }
  .price-list { list-style: none; padding: 0; display: grid; gap: 0.6rem; }
  .price-list li { background: var(--color-off-white); border-radius: var(--radius-sm); padding: 0.7em 1em; }
  .process-list { padding-left: 1.2em; display: grid; gap: 0.4rem; }
  .lead-magnet { text-align: center; }
  .area-links { margin-top: 1rem; font-size: 0.9rem; color: var(--color-grey-600); }
  .review-card { border: none; }
  .review-card footer { margin-top: 0.75em; font-weight: 600; color: var(--color-navy-800); }
  .install-gallery {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
    max-width: 68ch;
    margin-top: 1.25rem;
  }
  .install-gallery img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--radius-md);
    display: block;
  }
  @media (max-width: 640px) {
    .install-gallery { grid-template-columns: 1fr 1fr; }
  }
</style>
