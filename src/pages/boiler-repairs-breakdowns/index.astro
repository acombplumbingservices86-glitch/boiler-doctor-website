---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTABand from "../../components/CTABand.astro";
import NeedsInput from "../../components/NeedsInput.astro";
import { siteConfig } from "../../data/siteConfig";

const title = "Boiler Repairs & Breakdown Cover in York | The Boiler Doctor";
const description =
  "Boiler broken down? Fast, honest repairs from York's own Steve and Kyle. £100 + VAT call-out, agreed upfront. Call 01904 206190.";

const faqs = [
  { q: "No heating or hot water", a: "Often a pressure, valve or PCB fault — usually diagnosed and fixed same visit." },
  { q: "Boiler losing pressure", a: "Could be a small leak or a faulty valve. Worth an eye on the pressure gauge before we visit." },
  { q: "Strange noises (kettling, banging)", a: "Often sludge or limescale build-up — sometimes solved by a service, sometimes needs a power flush." },
  { q: "Pilot light won't stay lit", a: "Usually a thermocouple issue — a quick, inexpensive fix in most cases." },
  { q: "Error codes on the display", a: "Tell us the code when you call — it usually points us straight to the fault before we even arrive." },
  { q: "Leaking boiler", a: "Turn off the water supply if you can do so safely, then call us — this one's worth same-day attention." },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": { "@type": "Answer", "text": item.a },
  })),
};
---
<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <section class="section">
    <div class="container">
      <h1>Boiler Broken Down? We'll Sort It.</h1>
      <p class="lede">Same-day and next-day repairs across York and Acomb. No pushy upsell — if it can be fixed, we'll fix it.</p>
      <div class="hero__actions">
        <a href={siteConfig.phoneHref} class="btn btn--primary">Call {siteConfig.phoneDisplay}</a>
        <a href="/book-online/" class="btn btn--secondary">Book Online</a>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container narrow">
      <h2>Common breakdowns we fix</h2>
      <div class="faq-list">
        {faqs.map((item) => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>What it costs</h2>
      <ul class="price-list">
        <li><strong>Call-out / diagnostic:</strong> {siteConfig.minCallOutFee} minimum</li>
        <li><strong>Unquoted extra work:</strong> £85/hour</li>
        <li>Any repair beyond that is quoted before we start — you agree the price, then we do the work.</li>
      </ul>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container narrow">
      <h2>Real customer story</h2>
      <blockquote class="card review-card">
        <p>"Called about a toilet with a broken flush in a rental property — quick and professional, sorted the same day."</p>
        <footer>— Ian Ilsley</footer>
      </blockquote>
      <NeedsInput label="NEEDS ASSET: more repair-specific reviews, with permission to feature by name" />
    </div>
  </section>

  <CTABand heading="Cold house, hot temper? Let's fix that." />
</BaseLayout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-grey-600); max-width: 48ch; }
  .hero__actions { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1.25rem; }
  .narrow { max-width: 68ch; }
  .faq-list { display: grid; gap: 0.75rem; }
  .faq-item {
    background: var(--color-white);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    box-shadow: var(--shadow-card);
  }
  .faq-item summary { font-weight: 700; cursor: pointer; }
  .faq-item p { margin: 0.6em 0 0; color: var(--color-grey-600); }
  .price-list { list-style: none; padding: 0; display: grid; gap: 0.6rem; }
  .price-list li { background: var(--color-off-white); border-radius: var(--radius-sm); padding: 0.7em 1em; }
  .review-card { border: none; }
  .review-card footer { margin-top: 0.75em; font-weight: 600; color: var(--color-navy-800); }
</style>
