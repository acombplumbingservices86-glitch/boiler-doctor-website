---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTABand from "../../components/CTABand.astro";
import NeedsInput from "../../components/NeedsInput.astro";
import TrustStrip from "../../components/TrustStrip.astro";
import { siteConfig } from "../../data/siteConfig";

const title = "Boiler Repairs & Breakdown Cover in York | The Boiler Doctor";
const description =
  "Boiler broken down? Fast, honest repairs from York's own Steve and Kyle. £100 + VAT call-out, agreed upfront. Call 01904 206190.";

const faqs = [
  { q: "No heating or hot water", a: "Often a pressure, valve or PCB fault — usually diagnosed and fixed same visit." },
  { q: "Boiler losing pressure", a: "Could be a small leak or a faulty valve — read our full pressure-troubleshooting guide below for what to check yourself first." },
  { q: "Strange noises (kettling, banging)", a: "Often sludge or limescale build-up — sometimes solved by a service, sometimes needs a power flush." },
  { q: "Pilot light won't stay lit", a: "Usually a thermocouple issue — a quick, inexpensive fix in most cases." },
  { q: "Error codes on the display", a: "Tell us the code when you call — it usually points us straight to the fault before we even arrive." },
  { q: "Leaking boiler", a: "Turn off the water supply if you can do so safely, then call us — this one's worth same-day attention." },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": { "@type": "Answer", "text": item.a },
  })),
};
---
<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <section class="section">
    <div class="container">
      <h1>Boiler Broken Down? We'll Sort It.</h1>
      <p class="lede">Same-day and next-day repairs across York and Acomb. No pushy upsell — if it can be fixed, we'll fix it.</p>
      <div class="hero__actions">
        <a href={siteConfig.phoneHref} class="btn btn--primary">Call {siteConfig.phoneDisplay}</a>
        <a href="/book-online/" class="btn btn--secondary">Book Online</a>
      </div>
    </div>
    <div class="container">
      <TrustStrip />
    </div>
  </section>

  <section class="section section--alt">
    <div class="container narrow">
      <h2>Common breakdowns we fix</h2>
      <div class="faq-list">
        {faqs.map((item) => (
          <details class="faq-item" open>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
      <p><a href="/advice-centre/why-is-my-boiler-losing-pressure/">Read the full pressure-troubleshooting guide →</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>What we actually find inside</h2>
      <p>Real evidence from real repair jobs — this is what years of missed servicing or a slow leak does on the inside.</p>
    </div>
    <div class="container evidence-gallery">
      <figure>
        <img src="/images/repairs/repair-heat-exchanger.jpg" alt="Heat exchanger removed from a boiler, caked in limescale build-up" loading="lazy" />
        <figcaption>A heat exchanger caked in limescale — years of hard water build-up, restricting flow.</figcaption>
      </figure>
      <figure>
        <img src="/images/repairs/repair-corroded-heat-exchanger.jpg" alt="Corroded heat exchanger fins found during a boiler repair" loading="lazy" />
        <figcaption>Corrosion on the exchanger fins — usually a sign servicing was missed for a few years running.</figcaption>
      </figure>
      <figure>
        <img src="/images/repairs/repair-strainer.jpg" alt="Corroded system strainer removed from a heating system" loading="lazy" />
        <figcaption>A corroded strainer, full of debris — this is what's actually flowing round your radiators.</figcaption>
      </figure>
      <figure>
        <img src="/images/repairs/repair-corroded-component.jpg" alt="Corroded boiler component found during diagnosis" loading="lazy" />
        <figcaption>A corroded component caught during diagnosis, before it failed completely.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>What it costs</h2>
      <ul class="price-list">
        <li><strong>Prices start from</strong> {siteConfig.minCallOutFee}</li>
        <li>Any repair beyond that is quoted before we start — you agree the price, then we do the work.</li>
      </ul>
      <p class="area-links">We've now got a dedicated page for every one of the 20 areas we cover — including <a href="/boiler-repairs-woodthorpe/">Woodthorpe</a>, <a href="/boiler-repairs-acomb/">Acomb</a> and <a href="/boiler-repairs-york/">York</a> — see the <a href="/service-areas/">full list of areas</a>.</p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container narrow">
      <h2>Real customer story</h2>
      <blockquote class="card review-card">
        <p>"The Boiler Doctor arrived promptly, as scheduled. He took a neat, methodical approach to diagnosing the fault with my..."</p>
        <footer>— Adrian Dale, <span class="badge">Boiler repair</span></footer>
      </blockquote>
      <p><a href="/reviews/">Read all {siteConfig.reviews.count} reviews →</a></p>
    </div>
  </section>

  <CTABand
    heading="Cold house, hot temper? Let's fix that."
    guideHref="/guides/emergency-boiler-checklist/"
    guideLabel="Get the emergency checklist"
  />
</BaseLayout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-grey-600); max-width: 48ch; }
  .hero__actions { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1.25rem; }
  .narrow { max-width: 68ch; }
  .faq-list { display: grid; gap: 0.75rem; }
  .faq-item {
    background: var(--color-white);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    box-shadow: var(--shadow-card);
  }
  .faq-item summary { font-weight: 700; cursor: pointer; }
  .faq-item p { margin: 0.6em 0 0; color: var(--color-grey-600); }
  .price-list { list-style: none; padding: 0; display: grid; gap: 0.6rem; }
  .price-list li { background: var(--color-off-white); border-radius: var(--radius-sm); padding: 0.7em 1em; }
  .review-card { border: none; }
  .review-card footer { margin-top: 0.75em; font-weight: 600; color: var(--color-navy-800); }
  .area-links { margin-top: 1rem; font-size: 0.9rem; color: var(--color-grey-600); }
  .evidence-gallery {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-top: -0.5rem;
  }
  .evidence-gallery figure { margin: 0; }
  .evidence-gallery img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--radius-md);
    display: block;
  }
  .evidence-gallery figcaption {
    font-size: 0.82rem;
    color: var(--color-grey-600);
    margin-top: 0.5rem;
  }
  @media (max-width: 900px) {
    .evidence-gallery { grid-template-columns: 1fr 1fr; }
  }
</style>
