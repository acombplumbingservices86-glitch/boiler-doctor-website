---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTABand from "../../components/CTABand.astro";
import TrustStrip from "../../components/TrustStrip.astro";
import { siteConfig } from "../../data/siteConfig";

const title = "Boiler Servicing & Annual Checks in York | The Boiler Doctor";
const description =
  "Keep your boiler safe, efficient and under warranty with an annual service. Gas Safe registered. Book online or call 01904 206190.";
---
<BaseLayout title={title} description={description}>
  <section class="section">
    <div class="container">
      <h1>One Service a Year Keeps the Cold Away</h1>
      <p class="lede">A proper annual boiler service protects your warranty, catches problems early, and keeps your gas safety certificate current.</p>
      <div class="hero__actions">
        <a href="/book-online/" class="btn btn--primary">Book a Service</a>
        <a href={siteConfig.phoneHref} class="btn btn--secondary">Call {siteConfig.phoneDisplay}</a>
        <a href="/boiler-care-plans/" class="btn btn--secondary">Compare Care Plans</a>
      </div>
    </div>
    <div class="container">
      <TrustStrip />
    </div>
  </section>

  <section class="section section--alt">
    <div class="container narrow">
      <h2>What's included</h2>
      <ul class="tick-list">
        <li>Full visual inspection</li>
        <li>Flue and ventilation check</li>
        <li>Gas pressure and burner check</li>
        <li>Safety device test</li>
        <li>Casing and seals inspection</li>
        <li>Full strip-down and clean of the heat exchanger</li>
        <li>Condenser trap cleaned out</li>
        <li>CO alarm check</li>
        <li>Written service record for your files and any warranty claim</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>Price</h2>
      <p class="price-highlight">£100 + VAT</p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container narrow">
      <h2>Why not just leave it</h2>
      <p>Manufacturer warranties are typically void without an annual service. A service often catches a small fault before it becomes a Saturday-night no-heat emergency. Landlords have a legal obligation too — see our <a href="/gas-safety-landlords/">Gas Safety &amp; Landlords</a> page.</p>
      <p><a href="/advice-centre/do-i-need-annual-service/">Read the full honest case for servicing every year →</a></p>
      <p class="area-links">We've now got a dedicated page for every one of the 20 areas we cover — including <a href="/boiler-servicing-woodthorpe/">Woodthorpe</a>, <a href="/boiler-servicing-acomb/">Acomb</a> and <a href="/boiler-servicing-york/">York</a> — see the <a href="/service-areas/">full list of areas</a>.</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>Real customer story</h2>
      <blockquote class="card review-card">
        <p>"We had The Boiler Doctor at our property for a regular service of the boiler. A thorough job was done and everything continues to be in working order. A strong recommendation for those who are curious."</p>
        <footer>— Stefan Bailey, <span class="badge">Boiler service</span></footer>
      </blockquote>
      <p><a href="/reviews/">Read all {siteConfig.reviews.count} reviews →</a></p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container narrow card care-cross-sell">
      <h2>If you're doing this every year anyway...</h2>
      <p>Our Checkup plan works out cheaper than a one-off service and throws in a free CO alarm.</p>
      <a href="/boiler-care-plans/" class="btn btn--primary">See Care Plans</a>
    </div>
  </section>

  <CTABand
    heading="Book your service before winter catches you out."
    guideHref="/guides/service-reminder/"
    guideLabel="Get a service reminder"
  />
</BaseLayout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-grey-600); max-width: 48ch; }
  .hero__actions { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1.25rem; }
  .narrow { max-width: 68ch; }
  .tick-list { list-style: none; padding: 0; display: grid; gap: 0.5rem; }
  .tick-list li { padding-left: 1.6em; position: relative; }
  .tick-list li::before { content: "✅"; position: absolute; left: 0; }
  .price-highlight { font-size: 2.5rem; font-weight: 800; color: var(--color-orange-600); }
  .care-cross-sell { text-align: center; }
  .area-links { margin-top: 1rem; font-size: 0.9rem; color: var(--color-grey-600); }
  .review-card { border: none; }
  .review-card footer { margin-top: 0.75em; font-weight: 600; color: var(--color-navy-800); }
</style>
