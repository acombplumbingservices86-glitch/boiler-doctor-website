---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTABand from "../../components/CTABand.astro";
import TrustStrip from "../../components/TrustStrip.astro";
import { siteConfig } from "../../data/siteConfig";

const title = "Prices | Boiler Service, Repair, Installation & Air Con, York";
const description =
  "Real starting prices for boiler servicing, repairs, new boiler installs, radiators and air conditioning in York. No hidden fees, no call to 'find out'.";

const prices = [
  {
    name: "Annual Boiler Service",
    price: "£120",
    blurb: "Keeps your manufacturer's warranty valid and catches small faults before they become breakdowns.",
    href: "/boiler-servicing/",
    linkLabel: "See what's included",
  },
  {
    name: "Boiler Repair / Breakdown",
    price: "£120",
    unit: "call-out",
    blurb: "Covers the visit and diagnosis. Any parts needed are priced and agreed with you before we start — never a surprise on the invoice.",
    href: "/boiler-repairs-breakdowns/",
    linkLabel: "See how repairs work",
  },
  {
    name: "New Boiler Installation",
    price: "From £2,500",
    blurb: "A like-for-like combi swap starts from £2,500. A system-to-combi conversion, where more pipework's involved, starts from £3,500. Most jobs land between £2,500 and £6,000.",
    href: "/new-boiler-installation/",
    linkLabel: "See the full cost breakdown",
  },
  {
    name: "Radiator Installation",
    price: "From £240",
    blurb: "A like-for-like radiator swap — same position, same pipework. Bigger jobs (extra radiators, moved pipework, upgrades) are priced once we've seen the room.",
    href: "/central-heating-radiators/",
    linkLabel: "See radiator & heating work",
  },
  {
    name: "Air Conditioning Installation",
    price: "From £1,500",
    unit: "0% VAT until 31 Mar 2027",
    blurb: "Covers a single split system, supplied and fitted. Qualifying systems (fixed, and capable of both heating and cooling) are zero-rated for VAT until 31 March 2027 — after that, the rate rises, so the price here may need a small update nearer the time.",
    href: "/air-conditioning/",
    linkLabel: "See what we install",
  },
];
---
<BaseLayout title={title} description={description}>
  <section class="section">
    <div class="container">
      <h1>Our Prices, Before You Even Pick Up the Phone</h1>
      <p class="lede">Real starting prices for every job we do — servicing, repairs, new boilers, radiators and air conditioning. No "call us to find out."</p>
      <div class="hero__actions">
        <a href="/book-online/" class="btn btn--primary">Book Online</a>
        <a href={siteConfig.phoneHref} class="btn btn--secondary">Call {siteConfig.phoneDisplay}</a>
      </div>
    </div>
    <div class="container">
      <TrustStrip />
    </div>
  </section>

  <section class="section section--alt">
    <div class="container narrow">
      <h2>Why we publish our prices</h2>
      <p>A lot of the calls we get start the same way: someone's been let down by an engineer who wouldn't give them a straight answer on cost, sometimes more than once. We'd rather you knew what things cost before you rang us, not after we'd turned up.</p>
      <p>These are real starting prices, not numbers dressed up to get you on the phone. If one of them puts you off, that's fine — better you find that out now than after we've booked a visit. And if it doesn't, you already know roughly where you stand before we've even met.</p>
      <p>Every job still gets a free, written quote before anything's agreed. What's below is the honest starting point — the exact figure depends on your boiler, your radiators, and what's already in the house.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>What things cost</h2>
      <div class="price-grid">
        {prices.map((item) => (
          <div class="card price-card">
            <h3>{item.name}</h3>
            <p class="price-card__price">{item.price} {item.unit && <span>{item.unit}</span>}</p>
            <p class="price-card__blurb">{item.blurb}</p>
            <a href={item.href}>{item.linkLabel} →</a>
          </div>
        ))}
      </div>
      <p class="price-note">All prices shown are what you pay — no VAT to add on top. Deposit required on jobs over £1,000 (set out in your written quote); balance due on completion.</p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container narrow">
      <h2>Want cover instead of one-off costs?</h2>
      <p>Our care plans start from £12.99/month and include your annual service, so a repair call-out never catches you off guard.</p>
      <p><a href="/boiler-care-plans/">Compare care plans →</a></p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>How we quote</h2>
      <ol class="process-list">
        <li>Tell us what's going on — call, WhatsApp, or book online</li>
        <li>Free visit where the job needs a look before we can price it properly</li>
        <li>Written quote with the price agreed upfront, before any work starts</li>
        <li>12 months' workmanship warranty from invoice date on every job</li>
      </ol>
    </div>
  </section>

  <CTABand
    heading="Know what it costs. Now get a proper quote."
    subheading="Free, written, no obligation — same as every price above."
  />
</BaseLayout>

<style>
  .lede { font-size: 1.1rem; color: var(--color-grey-600); max-width: 52ch; }
  .hero__actions { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1.25rem; }
  .narrow { max-width: 68ch; }
  .price-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }
  .price-card { display: flex; flex-direction: column; gap: 0.6rem; }
  .price-card h3 { font-size: clamp(1.05rem, 2vw, 1.2rem); margin: 0; }
  .price-card__price { font-size: 1.6rem; font-weight: 800; color: var(--color-navy-900); margin: 0; }
  .price-card__price span { display: block; font-size: 0.82rem; font-weight: 600; color: var(--color-grey-600); margin-top: 0.15em; }
  .price-card__blurb { font-size: 0.92rem; color: var(--color-grey-600); flex-grow: 1; margin: 0; }
  .price-note { margin-top: 1.25rem; font-size: 0.85rem; color: var(--color-grey-600); max-width: 68ch; }
  .process-list { padding-left: 1.2em; display: grid; gap: 0.4rem; }
</style>
